* {
  font-family: "Segoe UI", Arial, sans-serif;
  font-size: 13px;
  color: #f8f3dc;
}

#shell {
  background-color: #172736;
  border: 3px solid #0b1118;
  border-radius: 9px;
}

#titleBar {
  background-color: #203d55;
  border-bottom: 3px solid #0b1118;
  border-top-left-radius: 7px;
  border-top-right-radius: 7px;
}

#brand {
  color: #ffd24a;
  font-family: "Arial Black", "Segoe UI", sans-serif;
  font-size: 15px;
  font-weight: 900;
  letter-spacing: 2px;
}

#page {
  background-color: #172736;
}

#heading {
  color: #ffffff;
  font-size: 17px;
  font-weight: 800;
}

#sectionTitle {
  color: #9fc6df;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 1px;
}

#muted, #status {
  color: #a9becc;
}

#status[error="true"] {
  color: #ff8585;
}

#authorized {
  color: #79dc83;
  background-color: #193d2b;
  border: 2px solid #2c7046;
  border-radius: 5px;
  padding: 7px;
  font-size: 11px;
  font-weight: 800;
}

QLineEdit, QComboBox {
  background-color: #0f1c27;
  color: #ffffff;
  border: 2px solid #34556d;
  border-radius: 5px;
  padding: 9px 10px;
  selection-background-color: #e9a92f;
}

QLineEdit:focus, QComboBox:focus {
  border-color: #ffd24a;
}

QComboBox::drop-down {
  border: 0;
  width: 24px;
}

QComboBox QAbstractItemView {
  color: #ffffff;
  background-color: #0f1c27;
  selection-background-color: #34556d;
  border: 2px solid #34556d;
}

QPushButton {
  border-radius: 5px;
  font-weight: 800;
  padding: 9px;
}

#primaryButton, #commandButton {
  color: #251a07;
  background-color: #ffc43d;
  border: 2px solid #fff1a8;
  border-bottom: 4px solid #a66316;
}

#gameButton {
  color: #f4f8fb;
  background-color: #23455d;
  border: 2px solid #3d6882;
  border-bottom: 3px solid #0d2230;
  text-align: left;
  padding-left: 14px;
}

#gameButton:hover {
  color: #251a07;
  background-color: #ffc43d;
  border-color: #fff1a8;
}

#gameStatusButton {
  color: #eaffed;
  background-color: #237044;
  border: 2px solid #62c982;
  border-bottom: 4px solid #104226;
}

#gameStatusButton:hover {
  background-color: #2d8a55;
}

#gameStatusButton[running="true"] {
  color: #fff0f0;
  background-color: #a13a3a;
  border-color: #ef7777;
  border-bottom-color: #5d2020;
}

#gameStatusButton[running="true"]:hover {
  background-color: #bd4747;
}

#gameScroll {
  background: transparent;
  border: 0;
}

#scrollContent {
  background-color: #172736;
}

QScrollBar:vertical {
  background: #0f1c27;
  width: 9px;
  margin: 0;
}

QScrollBar::handle:vertical {
  background: #ffc43d;
  border-radius: 4px;
  min-height: 28px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
  height: 0;
}

#primaryButton:hover, #commandButton:hover {
  background-color: #ffd968;
}

#primaryButton:pressed, #commandButton:pressed {
  border-bottom: 2px solid #a66316;
  padding-top: 11px;
}

#primaryButton:disabled, #commandButton:disabled {
  color: #756d5b;
  background-color: #8c846f;
  border-color: #5c574c;
}

#secondaryButton {
  color: #c5dae8;
  background-color: #213b4e;
  border: 2px solid #34556d;
}

#secondaryButton:hover {
  background-color: #2a4c63;
}

#windowButton, #closeButton {
  color: #d9e9f2;
  background: transparent;
  border: 0;
  padding: 0;
  font-size: 16px;
}

#windowButton:hover {
  background-color: #31536b;
}

#closeButton:hover {
  color: white;
  background-color: #b94040;
}

#divider {
  color: #34556d;
  background-color: #34556d;
  max-height: 2px;
}
